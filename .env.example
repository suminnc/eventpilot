# Optional: any OpenAI-compatible endpoint. Without a key, EventPilot runs its built-in offline planner.
# StepFun (default)
LLM_BASE_URL=https://api.stepfun.ai/v1
LLM_MODEL=step-5-preview
LLM_API_KEY=
# LLM_MAX_TOKENS=4000        # per-call output cap (includes reasoning tokens)
# LLM_REASONING_EFFORT=low   # low|medium|high, or empty to omit
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# OFFLINE_PACE_MS=120  # stream pacing for the live trace in offline mode

# Photon 2.0 (optional): text the organizer for Autopilot decisions over iMessage/SMS.
# The organizer must text the agent number once first (shared lines can't start a conversation).
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_HANDLE=
PHOTON_ORGANIZER=
PHOTON_PLATFORM=imessage

# Real vendor emails (optional). Every message is redirected to EMAIL_REDIRECT_TO; vendors never receive them.
# Gmail / Google Workspace: use an App Password (Google Account > Security > App passwords).
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REDIRECT_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Vendor replies are read over IMAP with the same login and negotiated automatically.
# IMAP_HOST=imap.gmail.com
# VENDOR_POLL_SECONDS=5         # how often to check for vendor replies
# VENDOR_FOLLOWUP_MINUTES=1440  # nudge a quiet vendor after this long (2 nudges, then you're texted)
# AUTONOMOUS=1  # Ops Swarm runs new plans end to end when email is configured (set 0 to require RUN/SEND)

# CREAO hosted swarm agent (optional): app-scoped API Trigger key + app ID from agent.creao.ai
CREAO_API_KEY=
CREAO_APP_ID=
