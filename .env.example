# Optional: any OpenAI-compatible endpoint. Without a key, EventPilot runs its built-in offline planner.
# StepFun (default)
LLM_BASE_URL=https://api.stepfun.com/v1
LLM_MODEL=step-5-preview
LLM_API_KEY=
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# OFFLINE_PACE_MS=120  # stream pacing for the live trace in offline mode
